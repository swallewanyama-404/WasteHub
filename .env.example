APP_NAME=WasteHub API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

POSTGRES_DB=wastehub
POSTGRES_USER=wastehub
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://wastehub:replace-with-a-strong-database-password@db:5432/wastehub

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=240

MEDIA_ROOT=/app/media
PAYMENT_PROVIDER=manual_verification
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WASTEHUB_ADMIN_NAME=WasteHub Administrator
WASTEHUB_ADMIN_EMAIL=admin@example.com
WASTEHUB_ADMIN_PHONE=+256700000000
WASTEHUB_ADMIN_PASSWORD=replace-with-a-strong-admin-password
